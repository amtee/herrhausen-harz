---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEvents, germanDate, type EventEntry } from '../../lib/content';

export async function getStaticPaths() {
  const { upcoming, past } = await getEvents();
  return [...upcoming, ...past].map((entry: EventEntry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: EventEntry };
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="page-wrap">
    <header class="page-header"><p class="section-kicker">Veranstaltung · {germanDate.format(entry.data.date)}</p><h1>{entry.data.title}</h1></header>
    <div class="page-content prose"><p class="lead">{entry.data.summary}</p><Content /></div>
  </article>
</BaseLayout>